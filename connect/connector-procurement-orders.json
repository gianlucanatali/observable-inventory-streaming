{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "${PROCUREMENT_HOST}",
  "database.port": "${PG_PORT}",
  "database.user": "debezium",
  "database.password": "${PG_DEBEZIUM_PASSWORD}",
  "database.dbname": "${PROCUREMENT_DATABASE}",
  "plugin.name": "pgoutput",
  "slot.name": "dbz_procurement",
  "publication.name": "dbz_procurement",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "public.purchase_order",
  "snapshot.mode": "initial",
  "tombstones.on.delete": "false",
  "topic.prefix": "procurement",
  "transforms": "route",
  "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.route.regex": "procurement\\.public\\.purchase_order",
  "transforms.route.replacement": "procurement.orders",
  "key.converter": "io.confluent.connect.avro.AvroConverter",
  "key.converter.schema.registry.url": "${SR_URL}",
  "key.converter.basic.auth.credentials.source": "USER_INFO",
  "key.converter.basic.auth.user.info": "${SR_API_KEY}:${SR_API_SECRET}",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "${SR_URL}",
  "value.converter.basic.auth.credentials.source": "USER_INFO",
  "value.converter.basic.auth.user.info": "${SR_API_KEY}:${SR_API_SECRET}",
  "schema.name.adjustment.mode": "avro"
}
