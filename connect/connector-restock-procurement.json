{
  "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
  "tasks.max": "1",
  "topics": "restock.requests",
  "connection.url": "jdbc:postgresql://${PROCUREMENT_HOST}:5432/${PROCUREMENT_DATABASE}",
  "connection.user": "${PROCUREMENT_USER}",
  "connection.password": "${PROCUREMENT_PASSWORD}",
  "insert.mode": "upsert",
  "pk.mode": "record_value",
  "pk.fields": "request_id",
  "table.name.format": "purchase_order",
  "auto.create": "false",
  "auto.evolve": "false",
  "delete.enabled": "false",
  "fields.whitelist": "request_id,store_id,product_id,quantity_requested,requested_at_ms",
  "key.converter": "io.confluent.connect.avro.AvroConverter",
  "key.converter.schema.registry.url": "${SR_URL}",
  "key.converter.basic.auth.credentials.source": "USER_INFO",
  "key.converter.basic.auth.user.info": "${SR_API_KEY}:${SR_API_SECRET}",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "${SR_URL}",
  "value.converter.basic.auth.credentials.source": "USER_INFO",
  "value.converter.basic.auth.user.info": "${SR_API_KEY}:${SR_API_SECRET}",
  "transforms": "dropTombstones",
  "transforms.dropTombstones.type": "org.apache.kafka.connect.transforms.Filter",
  "transforms.dropTombstones.predicate": "isTombstone",
  "predicates": "isTombstone",
  "predicates.isTombstone.type": "org.apache.kafka.connect.transforms.predicates.RecordIsTombstone",
  "errors.tolerance": "none"
}
