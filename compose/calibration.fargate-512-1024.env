# Non-secret Fargate profile: regression task CPU units-MiB, ARM64.
# All three inventory-api releases share 0.5 vCPU / 1 GB (canary-first incident:
# the regression is not absorbed by a larger task). Live latency acceptance pending.
# Terraform consumes this complete per-service map via TF_VAR_service_sizing.
TF_VAR_service_sizing={"stock-projector":{"cpu":512,"memory":1024},"inventory-api-100":{"cpu":512,"memory":1024},"inventory-api-110":{"cpu":512,"memory":1024},"inventory-api-120":{"cpu":512,"memory":1024},"storefront":{"cpu":512,"memory":1024},"offer-worker":{"cpu":512,"memory":1024},"demo-control":{"cpu":256,"memory":512},"cost-meter":{"cpu":256,"memory":512}}
CATALOGUE_PRODUCTS=3000
LOAD_RPS=5
LOAD_DURATION=120
