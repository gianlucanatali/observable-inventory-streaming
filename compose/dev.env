# Local rehearsal values for compose.dev.yaml. No secrets: a throwaway Kafka/Schema Registry with no auth.
# Placeholders for the per-app credentials only satisfy `${VAR:?}` checks; the dev broker ignores them.
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_REPLICATION_FACTOR=1
SR_URL=http://schema-registry:8081
CONNECT_KAFKA_API_KEY=dev
CONNECT_KAFKA_API_SECRET=dev
CONNECT_SR_API_KEY=dev
CONNECT_SR_API_SECRET=dev
PROJECTOR_KAFKA_API_KEY=dev
PROJECTOR_KAFKA_API_SECRET=dev
PROJECTOR_SR_API_KEY=dev
PROJECTOR_SR_API_SECRET=dev
STOREFRONT_KAFKA_API_KEY=dev
STOREFRONT_KAFKA_API_SECRET=dev
STOREFRONT_SR_API_KEY=dev
STOREFRONT_SR_API_SECRET=dev
OFFERS_KAFKA_API_KEY=dev
OFFERS_KAFKA_API_SECRET=dev
OFFERS_SR_API_KEY=dev
OFFERS_SR_API_SECRET=dev
DEMO_CONTROL_KAFKA_API_KEY=dev
DEMO_CONTROL_KAFKA_API_SECRET=dev
DEMO_CONTROL_SR_API_KEY=dev
DEMO_CONTROL_SR_API_SECRET=dev
# 8080 on the Mac is taken by another Lima VM (datadog-psa-practice); the dev ingress uses 8088.
INGRESS_PORT=8088
# Stack name: DD_ENV=dd-demo-$STACK, compose project dd-demo-$STACK. A shell/make STACK=... overrides this.
STACK=dev
