{
  "_doc": [
    "Shared cases for the confirmed-minimum rule (contracts/README.md section 5).",
    "Every reader that decides 'can I sell this?' runs this table against its own code through fakeredis:",
    "inventory-api (tests/test_api.py, via GET /api/availability) and offer-worker (tests/test_stock.py, via ConfirmedStock).",
    "Fields: ns = stock:active_ns (null = key absent); ready = stock:{ns}:meta ready; sellable = sellable:{product} (null = key absent);",
    "positions = one entry per store in 'stores' order: an integer quantity, \"not_stocked\" (deleted=1) or null (no position);",
    "feeds = one entry per store: a state written now, null (no feed:status hash), or {state, age_ms} written age_ms before now.",
    "A store is live when the namespace is ready, its feed is ok and not older than feed_max_age_s, and its position is present."
  ],
  "product_id": "P0042",
  "stores": ["S01", "S02", "S03", "S04", "S05"],
  "feed_max_age_s": 10,
  "cases": [
    {"name": "all_live_is_the_flink_total",
     "ns": "n1", "ready": true, "sellable": 9, "positions": [2, 1, 3, 1, 2], "feeds": ["ok", "ok", "ok", "ok", "ok"],
     "expect": {"confirmed_min": 9, "at_least": false, "status": "available", "unknown_reason": null}},
    {"name": "lab2_stale_store_is_last_seen_not_counted",
     "ns": "n1", "ready": true, "sellable": 9, "positions": [2, 1, 3, 1, 2], "feeds": ["ok", "ok", "stale", "ok", "ok"],
     "expect": {"confirmed_min": 6, "at_least": true, "status": "available", "unknown_reason": null}},
    {"name": "stale_store_holds_the_only_stock",
     "ns": "n1", "ready": true, "sellable": 3, "positions": [0, 0, 3, 0, 0], "feeds": ["ok", "ok", "stale", "ok", "ok"],
     "expect": {"confirmed_min": 0, "at_least": true, "status": "unknown", "unknown_reason": "stores_unknown"}},
    {"name": "feed_older_than_limit_is_not_live",
     "ns": "n1", "ready": true, "sellable": 9, "positions": [2, 1, 3, 1, 2],
     "feeds": ["ok", "ok", {"state": "ok", "age_ms": 10001}, "ok", "ok"],
     "expect": {"confirmed_min": 6, "at_least": true, "status": "available", "unknown_reason": null}},
    {"name": "feed_exactly_at_limit_is_live",
     "ns": "n1", "ready": true, "sellable": 9, "positions": [2, 1, 3, 1, 2],
     "feeds": ["ok", "ok", {"state": "ok", "age_ms": 10000}, "ok", "ok"],
     "expect": {"confirmed_min": 9, "at_least": false, "status": "available", "unknown_reason": null}},
    {"name": "feed_missing_is_not_live",
     "ns": "n1", "ready": true, "sellable": 9, "positions": [2, 1, 3, 1, 2], "feeds": ["ok", "ok", null, "ok", "ok"],
     "expect": {"confirmed_min": 6, "at_least": true, "status": "available", "unknown_reason": null}},
    {"name": "feed_unknown_is_not_live",
     "ns": "n1", "ready": true, "sellable": 9, "positions": [2, 1, 3, 1, 2], "feeds": ["ok", "ok", "unknown", "ok", "ok"],
     "expect": {"confirmed_min": 6, "at_least": true, "status": "available", "unknown_reason": null}},
    {"name": "position_missing_is_not_live",
     "ns": "n1", "ready": true, "sellable": 6, "positions": [2, 1, null, 1, 2], "feeds": ["ok", "ok", "ok", "ok", "ok"],
     "expect": {"confirmed_min": 6, "at_least": true, "status": "available", "unknown_reason": null}},
    {"name": "not_stocked_is_live_and_counts_zero",
     "ns": "n1", "ready": true, "sellable": 12, "positions": [12, "not_stocked", 0, 0, 0], "feeds": ["ok", "ok", "ok", "ok", "ok"],
     "expect": {"confirmed_min": 12, "at_least": false, "status": "available", "unknown_reason": null}},
    {"name": "all_live_zero_is_out_of_stock",
     "ns": "n1", "ready": true, "sellable": 0, "positions": [0, 0, 0, 0, 0], "feeds": ["ok", "ok", "ok", "ok", "ok"],
     "expect": {"confirmed_min": 0, "at_least": false, "status": "out_of_stock", "unknown_reason": null}},
    {"name": "capped_by_the_flink_total",
     "ns": "n1", "ready": true, "sellable": 5, "positions": [2, 1, 3, 1, 2], "feeds": ["ok", "ok", "stale", "ok", "ok"],
     "expect": {"confirmed_min": 5, "at_least": true, "status": "available", "unknown_reason": null}},
    {"name": "namespace_not_ready",
     "ns": "n1", "ready": false, "sellable": 9, "positions": [2, 1, 3, 1, 2], "feeds": ["ok", "ok", "ok", "ok", "ok"],
     "expect": {"confirmed_min": null, "at_least": true, "status": "unknown", "unknown_reason": "not_ready"}},
    {"name": "namespace_missing",
     "ns": null, "ready": false, "sellable": 9, "positions": [2, 1, 3, 1, 2], "feeds": ["ok", "ok", "ok", "ok", "ok"],
     "expect": {"confirmed_min": null, "at_least": true, "status": "unknown", "unknown_reason": "not_ready"}},
    {"name": "flink_total_missing",
     "ns": "n1", "ready": true, "sellable": null, "positions": [2, 1, 3, 1, 2], "feeds": ["ok", "ok", "ok", "ok", "ok"],
     "expect": {"confirmed_min": null, "at_least": false, "status": "unknown", "unknown_reason": "not_found"}}
  ]
}
