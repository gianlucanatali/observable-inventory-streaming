{
  "type": "record", "name": "Offer", "namespace": "urbanstreet.offers",
  "doc": "Value of offers (compacted). offer_id is derived from risk_id. Structured fields own every fact; headline/body are descriptive wording only. Two independent parts: the alternative (product_id, null when none is offered) and the Restock notice (restock_eta, null when none). Neither: no Offer.",
  "fields": [
    {"name": "offer_id", "type": "string"},
    {"name": "risk_id", "type": "string"},
    {"name": "scenario_id", "type": "string"},
    {"name": "cart_id", "type": "string"},
    {"name": "original_store_id", "type": "string"},
    {"name": "original_product_id", "type": "string"},
    {"name": "offer_type", "type": {"type": "enum", "name": "OfferType", "symbols": ["SAME_PRODUCT_OTHER_STORE", "ALTERNATIVE_PRODUCT", "NOTIFY_ME"]}, "doc": "Kept for older readers: ALTERNATIVE_PRODUCT when an alternative is offered (with or without the Restock notice), else NOTIFY_ME, also when there is no Offer. New readers use product_id and restock_eta."},
    {"name": "store_id", "type": ["null", "string"], "default": null},
    {"name": "product_id", "type": ["null", "string"], "default": null},
    {"name": "discount_pct", "type": "int", "doc": "Set by policy only, 0..max allowed."},
    {"name": "headline", "type": "string"},
    {"name": "body", "type": "string"},
    {"name": "decision_route", "type": {"type": "enum", "name": "DecisionRoute", "symbols": ["JEV", "RULE_DEFAULT"]}},
    {"name": "decision_reason", "type": "string", "doc": "Why the alternative part was decided this way. Bounded label: accepted, no_good_substitute (JEV route, the AI judged none of the alternatives a good substitute), low_confidence, invalid_choice, timeout, error, rate_limited, kill_switch, disabled, no_alternative; no_choice only in older records."},
    {"name": "jev_choice", "type": ["null", "string"], "default": null, "doc": "Bounded Jev choice identifier (alt:<product_id> or none), absent when Jev did not return one."},
    {"name": "jev_confidence", "type": ["null", "double"], "default": null, "doc": "Jev confidence in 0..1, absent when Jev did not return one."},
    {"name": "min_confidence", "type": ["null", "double"], "default": null, "doc": "Applied Jev confidence threshold in 0..1."},
    {"name": "rule_choice", "type": ["null", "string"], "default": null, "doc": "Bounded safe-rule candidate identifier."},
    {"name": "chosen_choice", "type": ["null", "string"], "default": null, "doc": "Bounded final alternative identifier after revalidation, null when no alternative is offered."},
    {"name": "restock_eta", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null, "doc": "Restock notice: due time (real clock) of the open purchase order for the sold-out product, set only when it is within the near-restock limit. A fact, independent of the AI. Null: no Restock notice."},
    {"name": "text_route", "type": {"type": "enum", "name": "TextRoute", "symbols": ["BEDROCK", "TEMPLATE"]}},
    {"name": "text_reason", "type": "string", "doc": "Bounded label: accepted, invalid_text, timeout, error, disabled."},
    {"name": "created_at", "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
