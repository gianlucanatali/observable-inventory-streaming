#!/usr/bin/env python3
"""Validated public launcher for the existing demo Make lifecycle."""
from __future__ import annotations

import argparse
import ipaddress

import os
import re
import shlex
import stat
import subprocess
import sys
import tempfile
import textwrap
import urllib.request
from pathlib import Path

IP_LOOKUP_URL = "https://checkip.amazonaws.com"
ROOT = Path(__file__).resolve().parent
CONFIG = ROOT / "demo.yaml"
REQUIRED = {"stack", "aws_profile", "aws_region", "datadog_site", "dd_api_key", "dd_app_key", "confluent_cloud_api_key", "confluent_cloud_api_secret"}
OPTIONAL = {"allowed_cidr", "presenter_cidr", "jev_api_key", "keep_images", "layers", "mode", "owner"}
# owner: value of the owner tag on every AWS resource. AWS allows letters, digits, spaces and _ . : / = + - @ up to 256
# characters; spaces are left out here so the value stays one word for make and the shell. Same rule in stack.sh (OWNER).
OWNER_PATTERN = r"[A-Za-z0-9_.:/=+@-]{1,256}"
DEFAULT_LAYERS = "core"  # no layers key: core only; "all" = every layer except control-center
ALLOWED = REQUIRED | OPTIONAL
LAYERS = {"core", "releases", "restock", "offers", "dd-streams", "dd-synthetics", "dd-rum", "control-center"}
# mode: cloud (default, AWS + Confluent Cloud) | local (Lima VM on this laptop, no AWS or Confluent Cloud).
MODES = ("cloud", "local")
DEFAULT_MODE = "cloud"
# Local mode reads only these keys; the cloud keys may stay in the file (one-line flip) and are then ignored.
LOCAL_REQUIRED = {"datadog_site", "dd_api_key"}
LOCAL_USED = LOCAL_REQUIRED | {"mode", "layers", "jev_api_key"}
LOCAL_STACK = "dev"  # local data is always env dd-demo-dev, so it never mixes with a cloud stack in Datadog
LOCAL_LAYERS = ("releases", "restock", "offers")  # container layers; the others need the cloud (LOCAL.md)
LIMA_VM = "dd-demo"
SECRET_KEYS = {"dd_api_key", "dd_app_key", "confluent_cloud_api_key", "confluent_cloud_api_secret", "jev_api_key"}
PLACEHOLDERS = ("replace", "example", "changeme", "your_", "<", "placeholder")


def fail(message: str) -> None:
    raise ValueError(message)


def parse_yaml(path: Path) -> dict[str, str]:
    if not path.is_file():
        fail("demo.yaml is missing; copy demo.example.yaml to demo.yaml and chmod 600 demo.yaml")
    if stat.S_IMODE(path.stat().st_mode) != 0o600:
        fail("demo.yaml must be mode 0600; repair with: chmod 600 demo.yaml")
    values: dict[str, str] = {}
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if raw[:1].isspace() or ":" not in line:
            fail(f"demo.yaml:{number}: only top-level key: value entries are supported")
        key, value = line.split(":", 1)
        key, value = key.strip(), value.strip()
        if not re.fullmatch(r"[a-z][a-z0-9_]*", key) or (not value and key not in OPTIONAL):
            fail(f"demo.yaml:{number}: invalid key or empty value")
        if key in values:
            fail(f"demo.yaml:{number}: duplicate key '{key}'")
        if (value.startswith("\"") and value.endswith("\"")) or (value.startswith("'") and value.endswith("'")):
            value = value[1:-1]
        elif " #" in value:
            value = value.split(" #", 1)[0].rstrip()
        values[key] = value
    unknown = sorted(set(values) - ALLOWED)
    if "mode" in values and values["mode"] not in MODES:
        fail(f"demo.yaml: mode must be local or cloud, got '{values['mode']}' (remove the key for cloud)")
    values.setdefault("mode", DEFAULT_MODE)
    local = values["mode"] == "local"
    missing = sorted((LOCAL_REQUIRED if local else REQUIRED) - set(values))
    if unknown:
        fail("demo.yaml has unknown key(s): " + ", ".join(unknown))
    if missing:
        fail("demo.yaml is missing required key(s): " + ", ".join(missing))
    if local:  # cloud-only keys are ignored locally: not validated, not used, never written to .env
        for key in set(values) - LOCAL_USED:
            values.pop(key)
    if "allowed_cidr" in values and "presenter_cidr" in values:
        fail("demo.yaml may contain only one of allowed_cidr or presenter_cidr")
    if "presenter_cidr" in values:  # compatibility for existing private configs
        values["allowed_cidr"] = values.pop("presenter_cidr")
    if "layers" in values and not values["layers"]:
        fail("demo.yaml: 'layers' cannot be empty (remove the key for core only, or write core, all, or a comma list)")
    values.setdefault("layers", DEFAULT_LAYERS)
    for key, value in values.items():
        if not value and key not in OPTIONAL:
            fail(f"demo.yaml: '{key}' cannot be empty")
        if key != "owner" and any(marker in value.lower() for marker in PLACEHOLDERS):  # an owner may be jane.doe@example.com
            fail(f"demo.yaml: '{key}' still contains a placeholder")
    return values


def validate(values: dict[str, str]) -> None:
    if values.get("mode") == "local":
        validate_local(values)
        return
    if not re.fullmatch(r"[a-z][a-z0-9-]{1,15}", values["stack"]):
        fail("demo.yaml: stack must match ^[a-z][a-z0-9-]{1,15}$")
    if not re.fullmatch(r"[A-Za-z0-9_+=,.@-]{1,128}", values["aws_profile"]):
        fail("demo.yaml: aws_profile has an invalid shape")
    if not re.fullmatch(r"[a-z]{2}-[a-z]+-\d", values["aws_region"]):
        fail("demo.yaml: aws_region must look like eu-west-1")
    if values["datadog_site"] not in {"datadoghq.com", "datadoghq.eu", "us3.datadoghq.com", "us5.datadoghq.com", "ddog-gov.com"}:
        fail("demo.yaml: datadog_site is not supported")
    selected = values["layers"].split(",")
    if values["layers"] != "all" and (any(layer not in LAYERS for layer in selected) or len(selected) != len(set(selected))):
        fail("demo.yaml: layers must be all, or a unique comma-separated list of supported layers")

    if values.get("allowed_cidr"):
        try:
            network = ipaddress.IPv4Network(values["allowed_cidr"], strict=True)
        except ValueError:
            network = None
        if network is None or network.prefixlen != 32 or not values["allowed_cidr"].endswith("/32"):
            fail("demo.yaml: allowed_cidr must be a single IPv4 address in /32 form, for example 203.0.113.7/32 (or empty to auto-detect)")

    if "keep_images" in values and values["keep_images"] not in {"true", "false"}:
        fail("demo.yaml: keep_images must be true or false")

    if "owner" in values and not re.fullmatch(OWNER_PATTERN, values["owner"]):
        fail("demo.yaml: owner must be 1 to 256 characters from letters, digits and _ . : / = + - @ (no spaces), "
             "for example jane.doe@example.com; remove the key to use your local user name")

    for key in SECRET_KEYS - {"jev_api_key"}:
        if not re.fullmatch(r"[A-Za-z0-9_+=./:-]{8,512}", values[key]):
            fail(f"demo.yaml: {key} has an invalid credential shape")
    if values.get("jev_api_key") and not re.fullmatch(r"[A-Za-z0-9_+=./:-]{8,512}", values["jev_api_key"]):
        fail("demo.yaml: jev_api_key has an invalid credential shape")


def validate_local(values: dict[str, str]) -> None:
    """mode: local reads only datadog_site, dd_api_key, layers and jev_api_key (LOCAL_USED)."""
    if values["datadog_site"] not in {"datadoghq.com", "datadoghq.eu", "us3.datadoghq.com", "us5.datadoghq.com", "ddog-gov.com"}:
        fail("demo.yaml: datadog_site is not supported")
    selected = values["layers"].split(",")
    if values["layers"] != "all" and (any(layer not in LAYERS for layer in selected) or len(selected) != len(set(selected))):
        fail("demo.yaml: layers must be all, or a unique comma-separated list of supported layers")
    if not re.fullmatch(r"[A-Za-z0-9_+=./:-]{8,512}", values["dd_api_key"]):
        fail("demo.yaml: dd_api_key has an invalid credential shape")
    if values.get("jev_api_key") and not re.fullmatch(r"[A-Za-z0-9_+=./:-]{8,512}", values["jev_api_key"]):
        fail("demo.yaml: jev_api_key has an invalid credential shape")


def local_layers(layers: str) -> tuple[list[str], list[str]]:
    """(layers turned on locally, cloud-only layers skipped). all = every local layer; core is always on."""
    if layers == "all":
        return list(LOCAL_LAYERS), []
    chosen = [layer for layer in layers.split(",") if layer != "core"]
    return [layer for layer in chosen if layer in LOCAL_LAYERS], [layer for layer in chosen if layer not in LOCAL_LAYERS]


def env_lines(values: dict[str, str]) -> list[tuple[str, str]]:
    if values.get("mode") == "local":
        pairs = [("DD_SITE", values["datadog_site"]), ("DD_API_KEY", values["dd_api_key"])]
    else:
        pairs = [("DD_SITE", values["datadog_site"]), ("DD_API_KEY", values["dd_api_key"]),
                 ("DD_APP_KEY", values["dd_app_key"]), ("CONFLUENT_CLOUD_API_KEY", values["confluent_cloud_api_key"]),
                 ("CONFLUENT_CLOUD_API_SECRET", values["confluent_cloud_api_secret"])]
    if values.get("jev_api_key"):
        pairs.append(("JEV_API_KEY", values["jev_api_key"]))
    return pairs


def write_env(values: dict[str, str]) -> None:
    """Write .env (mode 0600). Cloud: the whole file from demo.yaml. Local: only the keys local mode reads are
    replaced and every other line is kept, so a cloud stack's Confluent and Datadog app keys survive a flip to local
    (./demo destroy of that stack still needs them)."""
    header = "# Generated by ./demo from demo.yaml; mode 0600. Do not edit secrets here."
    pairs = env_lines(values)
    kept: list[str] = []
    if values.get("mode") == "local" and (ROOT / ".env").is_file():
        managed = {key for key, _ in pairs}
        kept = [line for line in (ROOT / ".env").read_text(encoding="utf-8").splitlines()
                if line != header and line.split("=", 1)[0].strip() not in managed]
    lines = [header, *(f"{key}={value}" for key, value in pairs), *kept]
    fd, temporary = tempfile.mkstemp(prefix=".env.", dir=ROOT, text=True)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write("\n".join(lines) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, ROOT / ".env")
        os.chmod(ROOT / ".env", 0o600)
    except BaseException:
        try: os.unlink(temporary)
        except FileNotFoundError: pass
        raise


def make_base(values: dict[str, str]) -> list[str]:
    if values.get("mode") == "local":  # MODE=dev on the command line: the Makefile never reads demo.yaml for cloud values
        return ["make", "--no-print-directory", "-C", str(ROOT), "MODE=dev", f"STACK={LOCAL_STACK}", f"ENV_DIR={ROOT}"]
    args = ["make", "--no-print-directory", "-C", str(ROOT), "MODE=cloud", "TOPOLOGY=hybrid", f"STACK={values['stack']}", f"AWS_PROFILE={values['aws_profile']}", f"AWS_REGION={values['aws_region']}", f"ENV_DIR={ROOT}", f"LAYERS={values['layers']}", f"KEEP_IMAGES={values.get('keep_images', 'false')}"]
    if values.get("owner") and "OWNER" not in os.environ:  # an OWNER environment variable still wins (stack.sh reads it)
        args.append(f"OWNER={values['owner']}")
    if values.get("allowed_cidr"):
        args.extend((f"PRESENTER_CIDR={values['allowed_cidr']}", f"TF_VAR_presenter_cidr={values['allowed_cidr']}"))
    return args


def detect_public_ipv4() -> str:
    """Return this machine's public IPv4 as seen by checkip.amazonaws.com; raise ValueError if it cannot be determined."""
    try:
        with urllib.request.urlopen(IP_LOOKUP_URL, timeout=5) as response:
            text = response.read(64).decode("ascii", "replace").strip()
        return str(ipaddress.IPv4Address(text))
    except (OSError, ValueError) as error:
        raise ValueError(
            f"allowed_cidr is not set and your public IPv4 could not be detected via {IP_LOOKUP_URL} ({error}); "
            "set allowed_cidr in demo.yaml to your public IPv4 as a.b.c.d/32 (nothing was created)"
        ) from error


def resolve_allowed_cidr(values: dict[str, str], lookup: bool) -> None:
    """Fill an empty allowed_cidr with the caller's current IP/32 (create only). Runs before anything billable."""
    if values.get("allowed_cidr"):
        return
    if not lookup:  # dry run stays offline
        print("demo: allowed_cidr not set; create will use your current public IP as /32 (not looked up in a dry run)", file=sys.stderr)
        return
    address = detect_public_ipv4()
    print(f"demo: allowed_cidr not set; using your current IP {address}/32")
    values["allowed_cidr"] = f"{address}/32"


def display(command: list[str]) -> str:
    return " ".join(shlex.quote(item if not any(secret in item for secret in SECRET_KEYS) else item.split("=", 1)[0] + "=***") for item in command)


class StackFailed(Exception):
    """stack-up or stack-down failed; its final banner is already printed, main() only sets the exit code."""

    def __init__(self, code: int) -> None:
        super().__init__(f"exit {code}")
        self.code = code


RULE = "#" * 60
STACK_ACTIONS = {"stack-up": "create", "stack-down": "destroy"}


def stack_of(command: list[str]) -> str:
    return next((item.split("=", 1)[1] for item in command if item.startswith("STACK=")), "")


def print_banner(lines: list[str], failed: bool) -> None:
    """The final banner of a create or destroy, always the last output of ./demo (red/green on a terminal)."""
    colour = sys.stderr.isatty() and not os.environ.get("NO_COLOR")
    on, off = (("\033[1;31m" if failed else "\033[1;32m"), "\033[0m") if colour else ("", "")
    sys.stdout.flush()
    print("\n" + "\n".join(f"{on}{line}{off}" for line in lines), file=sys.stderr, flush=True)


def run_stack(command: list[str], action: str) -> None:
    """stack-up/stack-down: stack.sh writes .state/stack-<stack>.outcome (exit=<n>, then the banner). It is printed
    here, after make's own error line, so it is the last thing on the screen; a failure raises StackFailed."""
    stack = stack_of(command)
    outcome = ROOT / ".state" / f"stack-{stack}.outcome"
    outcome.unlink(missing_ok=True)
    result = subprocess.run(command, check=False, env={**os.environ, "DEMO_BANNER": "1"})
    code, lines = 0, []
    if outcome.is_file():
        first, *lines = outcome.read_text(encoding="utf-8").splitlines()
        code = int(first[len("exit="):]) if re.fullmatch(r"exit=\d+", first) else 1
    if result.returncode != 0 and not lines:  # stack.sh never reported (make or stack.sh failed before it could)
        head = (f"DESTROY INCOMPLETE: stack {stack} may be STILL BILLING" if action == "destroy"
                else f"CREATE FAILED: stack {stack} may be half-built and STILL BILLING")
        lines = [RULE, head, f"Cause: make {next(item for item in command if item in STACK_ACTIONS)} exited {result.returncode} before stack.sh reported a result (see above)",
                 f"Fix: fix the cause, then ./demo {action} --yes   (it resumes)", RULE]
    failed = result.returncode != 0 or code != 0
    if lines:
        print_banner(lines, failed)
    if failed:
        raise StackFailed(code or result.returncode)


def invoke(command: list[str], dry_run: bool) -> None:
    if dry_run:
        print(display(command))
        return
    action = next((STACK_ACTIONS[item] for item in command if item in STACK_ACTIONS), None)
    if action:
        run_stack(command, action)
    else:
        subprocess.run(command, check=True)


def prompt(message: str, yes: bool) -> None:
    if yes:
        return
    if not sys.stdin.isatty():
        raise ValueError("confirmation not received; rerun with --yes after reviewing the cost/destruction warning")
    # The question comes after minutes of build output: frame it so it stands out (colour only on a terminal).
    bold, reset = ("\033[1;33m", "\033[0m") if sys.stdout.isatty() and not os.environ.get("NO_COLOR") else ("", "")
    rule = "=" * 72
    print(f"\n{bold}{rule}\n  ACTION NEEDED: ./demo is waiting for your answer\n{rule}{reset}")
    print(textwrap.fill(message, width=72, initial_indent="  ", subsequent_indent="  "))
    if input(f"\n{bold}  Type yes and press Enter to continue (anything else stops here): {reset}").strip().lower() != "yes":
        raise ValueError("confirmation not received; rerun with --yes after reviewing the cost/destruction warning")


def cloud_stacks_left(env_dir: Path) -> list[str]:
    """Stacks whose .env.cloud-<stack> exists (stack.sh writes it at create and deletes it at the end of destroy)."""
    return sorted(p.name[len(".env.cloud-"):] for p in env_dir.glob(".env.cloud-*") if p.is_file())


def ask_purge(purge: bool, yes: bool) -> bool:
    """Local destroy keeps the data volumes unless --purge, or the presenter answers yes when asked (tty only)."""
    if purge:
        return True
    if yes or not sys.stdin.isatty():
        print("demo: keeping the local data volumes (pass --purge to delete them too)")
        return False
    return input("Also delete the local data volumes (store databases, Kafka, Redis)? [y/N]: ").strip().lower() in ("y", "yes")


def run_local(action: str, values: dict[str, str], base: list[str], args) -> None:
    """mode: local: the same commands on the Lima VM (MODE=dev). Nothing here creates a cloud resource."""
    if action == "create":
        on, skipped = local_layers(values["layers"])
        for layer in skipped:
            print(f"demo: layer {layer} is cloud-only; skipped locally (LOCAL.md, What is different locally)", file=sys.stderr)
        left = cloud_stacks_left(ROOT)
        if left:
            print("demo: WARNING: cloud stack(s) " + ", ".join(left) + " may still be running and billing. Switching to "
                  "mode: local does not destroy them: set mode: cloud and run ./demo destroy when you are done.", file=sys.stderr)
        command = [*base, "local-up", "LOCAL_LAYERS=" + ",".join(["core", *on])]
        if args.dry_run:
            invoke(command, True)
            return
        print(f"demo: local mode: containers in the Lima VM '{LIMA_VM}' on this laptop, no AWS or Confluent Cloud resources; Datadog still receives this stack's data.")
        write_env(values)
        invoke(command, False)
    elif action == "destroy":
        if args.dry_run:
            invoke([*base, "local-down", *(["PURGE=1"] if args.purge else [])], True)
            return
        invoke([*base, "local-down", *(["PURGE=1"] if ask_purge(args.purge, args.yes) else [])], False)
    elif action == "status":
        invoke([*base, "status"], args.dry_run)
        invoke([*base, "links"], args.dry_run)
    else:
        invoke([*base, {"links": "links", "reset": "reset"}[action]], args.dry_run)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("create", "destroy", "status", "links", "reset"))
    parser.add_argument("--yes", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--purge", action="store_true", help="mode: local destroy also deletes the local data volumes")
    args = parser.parse_args()
    try:
        values = parse_yaml(CONFIG)
        validate(values)
        if values["mode"] == "local":
            run_local(args.action, values, make_base(values), args)
            return 0
        if args.purge:
            raise ValueError("--purge is for mode: local only (a cloud destroy always deletes the stack)")
        if args.action == "create":
            resolve_allowed_cidr(values, lookup=not args.dry_run)
        base = make_base(values)
        if args.action == "create":
            if args.dry_run:
                invoke([*base, "secrets"], True)
                invoke([*base, "stack-preflight"], True)
                invoke([*base, "stack-up", "CONFIRM=yes"], True)
                return 0
            write_env(values)
            invoke([*base, "secrets"], False)
            invoke([*base, "stack-preflight"], False)
            prompt("This creates billed AWS and Confluent Cloud resources: about $1.50 to $2.50 per hour (AWS about $0.50, Confluent Cloud about $1 to $2; Datadog on its trial). This is an estimate, not a bill. Trial credit depends on your accounts, so check it.", args.yes)
            invoke([*base, "stack-up", "CONFIRM=yes"], False)
        elif args.action == "destroy":
            if not args.dry_run:
                prompt("This destroys the demo stack and its resources.", args.yes)
            invoke([*base, "stack-down", "CONFIRM=yes"], args.dry_run)
        else:
            invoke([*base, {"status": "stack-status", "links": "links", "reset": "reset"}[args.action]], args.dry_run)
        return 0
    except StackFailed as failure:  # the banner is already the last output; nothing may be printed after it
        return failure.code
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"demo: {error}", file=sys.stderr)
        return 2

if __name__ == "__main__":
    raise SystemExit(main())
