#!/usr/bin/env python3
"""Validated public launcher for the existing demo Make lifecycle."""
from __future__ import annotations

import argparse
import ipaddress

import os
import re
import shlex
import stat
import subprocess
import sys
import tempfile
import urllib.request
from pathlib import Path

IP_LOOKUP_URL = "https://checkip.amazonaws.com"
ROOT = Path(__file__).resolve().parent
CONFIG = ROOT / "demo.yaml"
REQUIRED = {"stack", "aws_profile", "aws_region", "layers", "datadog_site", "dd_api_key", "dd_app_key", "confluent_cloud_api_key", "confluent_cloud_api_secret"}
OPTIONAL = {"allowed_cidr", "presenter_cidr", "jev_api_key"}
ALLOWED = REQUIRED | OPTIONAL
LAYERS = {"core", "releases", "restock", "offers", "dd-streams", "dd-synthetics", "dd-rum", "control-center"}
SECRET_KEYS = {"dd_api_key", "dd_app_key", "confluent_cloud_api_key", "confluent_cloud_api_secret", "jev_api_key"}
PLACEHOLDERS = ("replace", "example", "changeme", "your_", "<", "placeholder")


def fail(message: str) -> None:
    raise ValueError(message)


def parse_yaml(path: Path) -> dict[str, str]:
    if not path.is_file():
        fail("demo.yaml is missing; copy demo.example.yaml to demo.yaml and chmod 600 demo.yaml")
    if stat.S_IMODE(path.stat().st_mode) != 0o600:
        fail("demo.yaml must be mode 0600; repair with: chmod 600 demo.yaml")
    values: dict[str, str] = {}
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if raw[:1].isspace() or ":" not in line:
            fail(f"demo.yaml:{number}: only top-level key: value entries are supported")
        key, value = line.split(":", 1)
        key, value = key.strip(), value.strip()
        if not re.fullmatch(r"[a-z][a-z0-9_]*", key) or (not value and key not in OPTIONAL):
            fail(f"demo.yaml:{number}: invalid key or empty value")
        if key in values:
            fail(f"demo.yaml:{number}: duplicate key '{key}'")
        if (value.startswith("\"") and value.endswith("\"")) or (value.startswith("'") and value.endswith("'")):
            value = value[1:-1]
        elif " #" in value:
            value = value.split(" #", 1)[0].rstrip()
        values[key] = value
    unknown = sorted(set(values) - ALLOWED)
    missing = sorted(REQUIRED - set(values))
    if unknown:
        fail("demo.yaml has unknown key(s): " + ", ".join(unknown))
    if missing:
        fail("demo.yaml is missing required key(s): " + ", ".join(missing))
    if "allowed_cidr" in values and "presenter_cidr" in values:
        fail("demo.yaml may contain only one of allowed_cidr or presenter_cidr")
    if "presenter_cidr" in values:  # compatibility for existing private configs
        values["allowed_cidr"] = values.pop("presenter_cidr")
    for key, value in values.items():
        if not value and key not in OPTIONAL:
            fail(f"demo.yaml: '{key}' cannot be empty")
        if any(marker in value.lower() for marker in PLACEHOLDERS):
            fail(f"demo.yaml: '{key}' still contains a placeholder")
    return values


def validate(values: dict[str, str]) -> None:
    if not re.fullmatch(r"[a-z][a-z0-9-]{1,15}", values["stack"]):
        fail("demo.yaml: stack must match ^[a-z][a-z0-9-]{1,15}$")
    if not re.fullmatch(r"[A-Za-z0-9_+=,.@-]{1,128}", values["aws_profile"]):
        fail("demo.yaml: aws_profile has an invalid shape")
    if not re.fullmatch(r"[a-z]{2}-[a-z]+-\d", values["aws_region"]):
        fail("demo.yaml: aws_region must look like eu-west-1")
    if values["datadog_site"] not in {"datadoghq.com", "datadoghq.eu", "us3.datadoghq.com", "us5.datadoghq.com", "ddog-gov.com"}:
        fail("demo.yaml: datadog_site is not supported")
    selected = values["layers"].split(",")
    if not selected or any(layer not in LAYERS for layer in selected) or len(selected) != len(set(selected)):
        fail("demo.yaml: layers must be a unique comma-separated list of supported layers")

    if values.get("allowed_cidr"):
        try:
            network = ipaddress.IPv4Network(values["allowed_cidr"], strict=True)
        except ValueError:
            network = None
        if network is None or network.prefixlen != 32 or not values["allowed_cidr"].endswith("/32"):
            fail("demo.yaml: allowed_cidr must be a single IPv4 address in /32 form, for example 203.0.113.7/32 (or empty to auto-detect)")

    for key in SECRET_KEYS - {"jev_api_key"}:
        if not re.fullmatch(r"[A-Za-z0-9_+=./:-]{8,512}", values[key]):
            fail(f"demo.yaml: {key} has an invalid credential shape")
    if values.get("jev_api_key") and not re.fullmatch(r"[A-Za-z0-9_+=./:-]{8,512}", values["jev_api_key"]):
        fail("demo.yaml: jev_api_key has an invalid credential shape")


def write_env(values: dict[str, str]) -> None:
    lines = [
        "# Generated by ./demo from demo.yaml; mode 0600. Do not edit secrets here.",
        f"DD_SITE={values['datadog_site']}",
        f"DD_API_KEY={values['dd_api_key']}",
        f"DD_APP_KEY={values['dd_app_key']}",
        f"CONFLUENT_CLOUD_API_KEY={values['confluent_cloud_api_key']}",
        f"CONFLUENT_CLOUD_API_SECRET={values['confluent_cloud_api_secret']}",
    ]
    if values.get("jev_api_key"):
        lines.append(f"JEV_API_KEY={values['jev_api_key']}")
    fd, temporary = tempfile.mkstemp(prefix=".env.", dir=ROOT, text=True)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write("\n".join(lines) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, ROOT / ".env")
        os.chmod(ROOT / ".env", 0o600)
    except BaseException:
        try: os.unlink(temporary)
        except FileNotFoundError: pass
        raise


def make_base(values: dict[str, str]) -> list[str]:
    args = ["make", "--no-print-directory", "-C", str(ROOT), "MODE=cloud", "TOPOLOGY=hybrid", f"STACK={values['stack']}", f"AWS_PROFILE={values['aws_profile']}", f"AWS_REGION={values['aws_region']}", f"ENV_DIR={ROOT}", f"LAYERS={values['layers']}"]
    if values.get("allowed_cidr"):
        args.extend((f"PRESENTER_CIDR={values['allowed_cidr']}", f"TF_VAR_presenter_cidr={values['allowed_cidr']}"))
    return args


def detect_public_ipv4() -> str:
    """Return this machine's public IPv4 as seen by checkip.amazonaws.com; raise ValueError if it cannot be determined."""
    try:
        with urllib.request.urlopen(IP_LOOKUP_URL, timeout=5) as response:
            text = response.read(64).decode("ascii", "replace").strip()
        return str(ipaddress.IPv4Address(text))
    except (OSError, ValueError) as error:
        raise ValueError(
            f"allowed_cidr is not set and your public IPv4 could not be detected via {IP_LOOKUP_URL} ({error}); "
            "set allowed_cidr in demo.yaml to your public IPv4 as a.b.c.d/32 (nothing was created)"
        ) from error


def resolve_allowed_cidr(values: dict[str, str], lookup: bool) -> None:
    """Fill an empty allowed_cidr with the caller's current IP/32 (create only). Runs before anything billable."""
    if values.get("allowed_cidr"):
        return
    if not lookup:  # dry run stays offline
        print("demo: allowed_cidr not set; create will use your current public IP as /32 (not looked up in a dry run)", file=sys.stderr)
        return
    address = detect_public_ipv4()
    print(f"demo: allowed_cidr not set; using your current IP {address}/32")
    values["allowed_cidr"] = f"{address}/32"


def display(command: list[str]) -> str:
    return " ".join(shlex.quote(item if not any(secret in item for secret in SECRET_KEYS) else item.split("=", 1)[0] + "=***") for item in command)


def invoke(command: list[str], dry_run: bool) -> None:
    if dry_run:
        print(display(command))
    else:
        subprocess.run(command, check=True)


def prompt(message: str, yes: bool) -> None:
    if yes:
        return
    if not sys.stdin.isatty() or input(message + " Type yes to continue: ").strip().lower() != "yes":
        raise ValueError("confirmation not received; rerun with --yes after reviewing the cost/destruction warning")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("create", "destroy", "status", "links", "reset"))
    parser.add_argument("--yes", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    try:
        values = parse_yaml(CONFIG)
        validate(values)
        if args.action == "create":
            resolve_allowed_cidr(values, lookup=not args.dry_run)
        base = make_base(values)
        if args.action == "create":
            if args.dry_run:
                invoke([*base, "secrets"], True)
                invoke([*base, "stack-preflight"], True)
                invoke([*base, "stack-up", "CONFIRM=yes"], True)
                return 0
            write_env(values)
            invoke([*base, "secrets"], False)
            invoke([*base, "stack-preflight"], False)
            prompt("This creates billed AWS and Confluent Cloud resources: about $1.50 to $2.50 per hour (AWS about $0.50, Confluent Cloud about $1 to $2; Datadog on its trial). This is an estimate, not a bill. Trial credit depends on your accounts, so check it.", args.yes)
            invoke([*base, "stack-up", "CONFIRM=yes"], False)
        elif args.action == "destroy":
            if not args.dry_run:
                prompt("This destroys the demo stack and its resources.", args.yes)
            invoke([*base, "stack-down", "CONFIRM=yes"], args.dry_run)
        else:
            invoke([*base, {"status": "stack-status", "links": "links", "reset": "reset"}[args.action]], args.dry_run)
        return 0
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"demo: {error}", file=sys.stderr)
        return 2

if __name__ == "__main__":
    raise SystemExit(main())
